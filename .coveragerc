[run]
# Without "source" coverage only reports files that happened to be imported, which pulls in
# the whole stdlib and makes TOTAL meaningless. Scoped here, TOTAL is the package's own
# number, wa*.py entry points included.
source = src/wa_crypt_tools
# tests/tools-invocation/ runs the console scripts as subprocesses. Each one measures itself
# into its own data file, which pytest-cov combines at the end; see conftest.py for the
# COVERAGE_PROCESS_START half of it. Without this the entry points all report 0%.
parallel = true
omit =
    */tests/*
    */proto/*

[report]
# A ratchet against a real regression, not a target to chase: at the current number every
# refactor that moves a few lines goes red.
#
# It lives here rather than as --cov-fail-under on CI's pytest call so that a local
# `python -m pytest --cov` fails the same way CI does -- which is exactly why the floor is 80
# and not the 90 the CI number alone would suggest. The suite reports two very different
# numbers depending on whether a display exists:
#
#     ~94%   CI: the Ubuntu leg runs under xvfb, and Tk on the Windows leg needs no display
#     ~83%   a headless machine: tests/gui/test_app.py skips, and gui/app.py falls to 22%
#
# The floor has to clear the lower one or `pytest --cov` over SSH fails for a reason that has
# nothing to do with the change being tested. 80 still catches what this is for: the
# subprocess-coverage plumbing breaking takes every wa*.py to 0% and the total to ~57%.
# Raising it means making app.py's widget code reachable without a display first.
fail_under = 80
